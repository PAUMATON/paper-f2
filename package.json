{
  "name": "arrel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arrel: arbres d'aprenentatge generats amb IA",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
